{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-agent-inbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"DOMAINS": "example.com",
		"EMAIL_ADDRESSES": []
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "cf-agent-inbox"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		}
	]
}
